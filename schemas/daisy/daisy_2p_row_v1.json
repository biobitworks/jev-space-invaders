{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DAISY_2P_ROW_V1",
  "type": "object",
  "required": [
    "corpus_id",
    "state_id",
    "vita_action",
    "opponent_action",
    "successor_state_id",
    "vita_outcome",
    "opponent_outcome",
    "relative_payoff"
  ],
  "properties": {
    "corpus_id": {
      "pattern": "_2P_"
    }
  },
  "not": {
    "anyOf": [
      {
        "required": [
          "action"
        ]
      },
      {
        "required": [
          "recommended_action"
        ]
      }
    ]
  },
  "description": "future joint-action corpus; not part of Pilot evidence unless separately authorized"
}
